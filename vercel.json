{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "functions": {
        "main.py": {
          "maxDuration": 10,
          "excludeFiles": "{frontend/**,tests/**,docs/**,.kiro/**,**/__pycache__/**}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci --no-audit --no-fund",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/phone", "destination": "/phone/index.html" },
        { "source": "/phone/", "destination": "/phone/index.html" },
        { "source": "/m", "destination": "/phone/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/ussd", "destination": { "service": "app" } },
    { "source": "/api/(.*)", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
