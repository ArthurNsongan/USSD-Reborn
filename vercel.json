{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci --no-audit --no-fund && npm run build",
  "functions": {
    "main.py": {
      "maxDuration": 10,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,tests/**,docs/**,.kiro/**,**/__pycache__/**}"
    }
  }
}
