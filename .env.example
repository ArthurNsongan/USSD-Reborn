# ==============================================================================
# GhostSignal · USSD-Reborn — Environment Variables (all optional)
# Copy this file to .env and adjust values as needed.
# Without LLM_API_KEY, the deterministic local GSM-7 fallback is used automatically.
# ==============================================================================

# --- Session storage ---
# SQLite database file path (":memory:" is accepted for ephemeral runs)
USSD_DB_PATH=ussd_sessions.db

# --- HTTP server (used by `python main.py`) ---
USSD_HOST=127.0.0.1
USSD_PORT=8000

# Comma-separated CORS origins allowed by FastAPI
USSD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional LLM Semantic Compressor ---
# Preset provider: openai | groq | gemini (leave empty to stay 100% offline/deterministic)
LLM_PROVIDER=
# API key enabling AI compression on nodes with useAiCompression: true
LLM_API_KEY=
# Optional overrides (defaults are chosen automatically from LLM_PROVIDER)
LLM_MODEL=
LLM_BASE_URL=
# Hard deadline in seconds before switching to the deterministic local fallback
LLM_TIMEOUT_SEC=1.8
