# Normalise text files to LF in the repository.
* text=auto

# Shell scripts must keep LF on every checkout, otherwise bash fails on Windows clones.
*.sh text eol=lf

# PowerShell and batch files keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
