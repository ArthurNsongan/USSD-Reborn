  "quickPresets": [
    { "label": "Prix plantain a Sandaga", "inputs": "1*1*1" },
    { "label": "Diagnostic pourriture brune", "inputs": "2*1" },
    { "label": "Meteo Littoral 48h", "inputs": "3*1" },
    { "label": "Conseil IA: manioc", "inputs": "4*taches blanches feuilles manioc" }
  ],
  "nodes": {
    "home": {
      "type": "menu",
      "title": "AgriPulse CM (*384*1#)",
      "options": [
        { "key": "1", "label": "Prix des vivres", "next": "price_market" },
        { "key": "2", "label": "Diagnostic cacao", "next": "cocoa_symptom" },
        { "key": "3", "label": "Meteo agricole", "next": "weather_zone" },
        { "key": "4", "label": "Conseil IA rapide", "next": "advice_question" }
      ]
    },
    "price_market": {
      "type": "menu",
      "title": "Prix du jour - Marche:",
      "options": [
        { "key": "1", "label": "Douala (Sandaga)", "next": "price_product", "set": { "market": "sandaga" } },
        { "key": "2", "label": "Yaounde (Mfoundi)", "next": "price_product", "set": { "market": "mfoundi" } },
        { "key": "3", "label": "Bafoussam", "next": "price_product", "set": { "market": "bafoussam" } },
        { "key": "4", "label": "Bamenda", "next": "price_product", "set": { "market": "bamenda" } }
      ]
    },
    "price_product": {
      "type": "menu",
      "title": "Choisir la denree:",
      "options": [
        { "key": "1", "label": "Plantain", "next": "price_result", "set": { "product": "plantain" } },
        { "key": "2", "label": "Manioc", "next": "price_result", "set": { "product": "manioc" } },
        { "key": "3", "label": "Macabo", "next": "price_result", "set": { "product": "macabo" } },
        { "key": "4", "label": "Huile de palme", "next": "price_result", "set": { "product": "huile_palme" } },
        { "key": "5", "label": "Cacao (kg)", "next": "price_result", "set": { "product": "cacao" } }
      ]
    },
    "price_result": {
      "type": "action",
      "handler": "get_market_price",
      "end": true
    },
    "cocoa_symptom": {
      "type": "menu",
      "title": "Diagnostic cacao - Symptome:",
      "options": [
        { "key": "1", "label": "Cabosses noires/brunes", "next": "cocoa_result", "set": { "symptom": "black_pod" } },
        { "key": "2", "label": "Piqures noires/trous", "next": "cocoa_result", "set": { "symptom": "mirids" } },
        { "key": "3", "label": "Feuilles jaunes/gonflees", "next": "cocoa_result", "set": { "symptom": "swollen_shoot" } }
      ]
    },
    "cocoa_result": {
      "type": "action",
      "handler": "diagnose_cocoa",
      "end": true
    },
    "weather_zone": {
      "type": "menu",
      "title": "Meteo agricole 48h - Zone:",
      "options": [
        { "key": "1", "label": "Littoral", "next": "weather_result", "set": { "zone": "littoral" } },
        { "key": "2", "label": "Centre", "next": "weather_result", "set": { "zone": "centre" } },
        { "key": "3", "label": "Ouest", "next": "weather_result", "set": { "zone": "ouest" } },
        { "key": "4", "label": "Sud-Ouest", "next": "weather_result", "set": { "zone": "sud_ouest" } }
      ]
    },
    "weather_result": {
      "type": "action",
      "handler": "get_weather",
      "end": true
    },
    "advice_question": {
      "type": "input",
      "prompt": "Conseil IA: decrivez le probleme en quelques mots (ex: taches feuilles manioc)",
      "saveAs": "question",
      "next": "advice_result",
      "example": "taches blanches feuilles manioc",
      "validation": { "kind": "text", "pattern": "^.{3,80}$" },
      "errorMessage": "Texte trop court ou trop long (3-80)."
    },
    "advice_result": {
      "type": "action",
      "handler": "quick_advice",
      "useAiCompression": true,
      "end": true
    }
  }
}
