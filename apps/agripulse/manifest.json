{
  "id": "agripulse",
  "name": "AgriPulse CM",
  "tagline": "Food market prices, cocoa disease diagnosis and farm weather for Cameroonian growers.",
  "shortcode": "*384*1#",
  "version": "1.1.0",
  "locale": "en-CM",
  "entryNode": "home",
  "theme": {
    "primaryColor": "#16a34a",
    "accentColor": "#86efac",
    "screenBg": "#06140b",
    "screenText": "#39ff7a",
    "bezelColor": "#14231a",
    "badgeLabel": "AGRI 2G",
    "icon": "🌱"
  },
  "navigation": {
    "backKey": "0",
    "homeKey": "00",
    "nextPageKey": "99",
    "sessionTimeoutSec": 180,
    "nextPageLabel": "99. More",
    "backLabel": "0. Back",
    "invalidMessage": "Invalid choice.",
    "expiredMessage": "Session expired. Dial *384*1# again.",
    "errorMessage": "Service unavailable. Try again."
  },
  "compression": {
    "abbreviations": {
      "Douala": "Dla",
      "Yaounde": "Yde",
      "treatment": "treat.",
      "fungicide": "fungic.",
      "insecticide": "insectic.",
      "prevention": "prev.",
      "neighbouring": "nearby",
      "weeks": "wks",
      "week": "wk",
      "days": "d",
      "approximately": "approx.",
      "humidity": "humid.",
      "temperature": "temp.",
      "recommended": "recom.",
      "maximum": "max",
      "minimum": "min",
      "kilogram": "kg",
      "within": "in",
      "with": "w/"
    }
  },
  "quickPresets": [
    { "label": "Plantain price at Sandaga", "inputs": "1*1*1" },
    { "label": "Diagnose black pod rot", "inputs": "2*1" },
    { "label": "Littoral weather 48h", "inputs": "3*1" },
    { "label": "AI advice: cassava", "inputs": "4*white spots on cassava leaves" }
  ],
  "nodes": {
    "home": {
      "type": "menu",
      "title": "AgriPulse CM (*384*1#)",
      "options": [
        { "key": "1", "label": "Food prices", "next": "price_market" },
        { "key": "2", "label": "Cocoa diagnosis", "next": "cocoa_symptom" },
        { "key": "3", "label": "Farm weather", "next": "weather_zone" },
        { "key": "4", "label": "Quick AI advice", "next": "advice_question" }
      ]
    },
    "price_market": {
      "type": "menu",
      "title": "Today's prices - Market:",
      "options": [
        { "key": "1", "label": "Douala (Sandaga)", "next": "price_product", "set": { "market": "sandaga" } },
        { "key": "2", "label": "Yaounde (Mfoundi)", "next": "price_product", "set": { "market": "mfoundi" } },
        { "key": "3", "label": "Bafoussam", "next": "price_product", "set": { "market": "bafoussam" } },
        { "key": "4", "label": "Bamenda", "next": "price_product", "set": { "market": "bamenda" } }
      ]
    },
    "price_product": {
      "type": "menu",
      "title": "Choose a product:",
      "options": [
        { "key": "1", "label": "Plantain", "next": "price_result", "set": { "product": "plantain" } },
        { "key": "2", "label": "Cassava", "next": "price_result", "set": { "product": "cassava" } },
        { "key": "3", "label": "Cocoyam (macabo)", "next": "price_result", "set": { "product": "cocoyam" } },
        { "key": "4", "label": "Palm oil", "next": "price_result", "set": { "product": "palm_oil" } },
        { "key": "5", "label": "Cocoa (kg)", "next": "price_result", "set": { "product": "cocoa" } }
      ]
    },
    "price_result": {
      "type": "action",
      "handler": "get_market_price",
      "end": true
    },
    "cocoa_symptom": {
      "type": "menu",
      "title": "Cocoa diagnosis - Symptom:",
      "options": [
        { "key": "1", "label": "Black/brown pods", "next": "cocoa_result", "set": { "symptom": "black_pod" } },
        { "key": "2", "label": "Black spots/holes", "next": "cocoa_result", "set": { "symptom": "mirids" } },
        { "key": "3", "label": "Yellow/swollen leaves", "next": "cocoa_result", "set": { "symptom": "swollen_shoot" } }
      ]
    },
    "cocoa_result": {
      "type": "action",
      "handler": "diagnose_cocoa",
      "end": true
    },
    "weather_zone": {
      "type": "menu",
      "title": "Farm weather 48h - Region:",
      "options": [
        { "key": "1", "label": "Littoral", "next": "weather_result", "set": { "zone": "littoral" } },
        { "key": "2", "label": "Centre", "next": "weather_result", "set": { "zone": "centre" } },
        { "key": "3", "label": "West", "next": "weather_result", "set": { "zone": "west" } },
        { "key": "4", "label": "South-West", "next": "weather_result", "set": { "zone": "south_west" } }
      ]
    },
    "weather_result": {
      "type": "action",
      "handler": "get_weather",
      "end": true
    },
    "advice_question": {
      "type": "input",
      "prompt": "Quick AI advice: describe the problem in a few words (e.g. spots on cassava leaves)",
      "saveAs": "question",
      "next": "advice_result",
      "example": "white spots on cassava leaves",
      "validation": { "kind": "text", "pattern": "^.{3,80}$" },
      "errorMessage": "Text too short or too long (3-80)."
    },
    "advice_result": {
      "type": "action",
      "handler": "quick_advice",
      "useAiCompression": true,
      "end": true
    }
  }
}
