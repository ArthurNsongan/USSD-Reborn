{
  "id": "tontine-check",
  "name": "Tontine-Check",
  "tagline": "Payout turns, late penalties, relief fund and verifiable receipts for njangi savings groups.",
  "shortcode": "*384*2#",
  "version": "1.1.0",
  "locale": "en-CM",
  "entryNode": "home",
  "theme": {
    "primaryColor": "#d97706",
    "accentColor": "#fde68a",
    "screenBg": "#140e04",
    "screenText": "#ffb830",
    "bezelColor": "#2a1d0c",
    "badgeLabel": "NJANGI 2G",
    "icon": "🪙"
  },
  "navigation": {
    "backKey": "0",
    "homeKey": "00",
    "nextPageKey": "99",
    "sessionTimeoutSec": 180,
    "nextPageLabel": "99. More",
    "backLabel": "0. Back",
    "invalidMessage": "Invalid choice.",
    "expiredMessage": "Session expired. Dial *384*2# again.",
    "errorMessage": "Service unavailable. Try again."
  },
  "compression": {
    "abbreviations": {
      "contribution": "contrib.",
      "contributions": "contribs",
      "penalty": "pen.",
      "member": "mbr",
      "members": "mbrs",
      "illness": "ill.",
      "meeting": "mtg"
    }
  },
  "quickPresets": [
    { "label": "My turn (member M03)", "inputs": "1*M03" },
    { "label": "Penalty: 25 000 FCFA, 5 days", "inputs": "2*25000*5" },
    { "label": "Relief fund", "inputs": "3" },
    { "label": "Verify receipt QT-2026-841", "inputs": "4*QT-2026-841" }
  ],
  "nodes": {
    "home": {
      "type": "menu",
      "title": "TontineCheck (*384*2#)",
      "options": [
        { "key": "1", "label": "My payout turn", "next": "turn_member" },
        { "key": "2", "label": "Late penalty calculator", "next": "penalty_amount" },
        { "key": "3", "label": "Relief fund", "next": "relief_overview" },
        { "key": "4", "label": "Verify a receipt", "next": "receipt_code" }
      ]
    },
    "turn_member": {
      "type": "input",
      "prompt": "Enter your member code (e.g. M03):",
      "saveAs": "member_code",
      "next": "turn_result",
      "example": "M03",
      "validation": { "kind": "code", "pattern": "^M[0-9]{2}$" },
      "errorMessage": "Invalid code. Format: M01"
    },
    "turn_result": {
      "type": "action",
      "handler": "member_turn",
      "end": true
    },
    "penalty_amount": {
      "type": "input",
      "prompt": "Contribution amount due (FCFA):",
      "saveAs": "amount",
      "next": "penalty_days",
      "example": "25000",
      "validation": { "kind": "numeric", "min": 500, "max": 5000000 },
      "errorMessage": "Invalid amount (500 to 5000000)."
    },
    "penalty_days": {
      "type": "input",
      "prompt": "Amount: {amount} FCFA\nNumber of days late:",
      "saveAs": "days",
      "next": "penalty_result",
      "example": "5",
      "validation": { "kind": "numeric", "min": 1, "max": 365 },
      "errorMessage": "Invalid days (1 to 365)."
    },
    "penalty_result": {
      "type": "action",
      "handler": "compute_penalty",
      "end": true
    },
    "relief_overview": {
      "type": "action",
      "handler": "relief_summary",
      "options": [
        { "key": "1", "label": "My eligibility", "next": "relief_member" }
      ]
    },
    "relief_member": {
      "type": "input",
      "prompt": "Aid eligibility: member code (e.g. M04):",
      "saveAs": "member_code",
      "next": "relief_result",
      "example": "M04",
      "validation": { "kind": "code", "pattern": "^M[0-9]{2}$" },
      "errorMessage": "Invalid code. Format: M01"
    },
    "relief_result": {
      "type": "action",
      "handler": "check_relief_eligibility",
      "end": true
    },
    "receipt_code": {
      "type": "input",
      "prompt": "Receipt code (e.g. QT-2026-841):",
      "saveAs": "receipt_code",
      "next": "receipt_result",
      "example": "QT-2026-841",
      "validation": { "kind": "code", "pattern": "^QT-[0-9]{4}-[0-9]{3}$" },
      "errorMessage": "Expected format: QT-2026-841"
    },
    "receipt_result": {
      "type": "action",
      "handler": "verify_receipt",
      "end": true
    }
  }
}
